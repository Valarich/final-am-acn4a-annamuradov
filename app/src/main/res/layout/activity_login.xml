<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    tools:context=".LoginActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/pantalla_padding">

            <TextView
                android:id="@+id/txtTituloLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/titulo_texto"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgLogin"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/margen_chico"
                android:contentDescription="@string/descripcion_imagen_habitos"
                android:src="@drawable/habitos" />

            <TextView
                android:id="@+id/txtDescripcionLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_chico"
                android:gravity="center"
                android:text="@string/descripcion_login"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/descripcion_texto" />

            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_medio"
                android:autofillHints="emailAddress"
                android:gravity="center_vertical"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingStart="@dimen/margen_chico"
                android:paddingEnd="@dimen/margen_chico"
                android:textColor="@color/color_texto_principal"
                android:textColorHint="@color/color_texto_principal" />

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_chico"
                android:autofillHints="password"
                android:gravity="center_vertical"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingStart="@dimen/margen_chico"
                android:paddingEnd="@dimen/margen_chico"
                android:textColor="@color/color_texto_principal"
                android:textColorHint="@color/color_texto_principal" />

            <Button
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_medio"
                android:minHeight="48dp"
                android:text="@string/boton_iniciar_sesion"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnIrRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_chico"
                android:minHeight="48dp"
                android:text="@string/boton_ir_registro"
                android:textAllCaps="false" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>